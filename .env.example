# ---- The Lord Erroll — on-premise server configuration ----
# Copy to .env and adjust. Everything here is local to the restaurant.

# Port the on-premise server listens on (all devices reach it over the LAN)
PORT=4000

# Host to bind. 0.0.0.0 exposes the server to the restaurant LAN.
HOST=0.0.0.0

# Absolute or relative path to the SQLite database file
DATABASE_PATH=./data/lord-erroll.db

# Secret used to sign staff session tokens. CHANGE THIS before go-live.
SESSION_SECRET=change-me-before-go-live

# Hostname printed on QR codes / table cards. Must resolve on the restaurant LAN.
# Use the server's static LAN IP if you have no local DNS, e.g. http://192.168.1.50:4000
PUBLIC_BASE_URL=http://order.lorderroll.local:4000

# Local backup destination (daily snapshot). Point at an external drive or NAS mount.
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=30

# Service charge and VAT, applied to bills. Kenyan defaults.
SERVICE_CHARGE_PERCENT=10
VAT_PERCENT=16
# Set to true if menu prices already include VAT (most Kenyan menus are VAT-inclusive)
PRICES_INCLUDE_VAT=true

# Currency display
CURRENCY=KES
USD_RATE=129

# ---- Exposure ----
# `lan` is this file's subject: plain HTTP on the restaurant's own network.
# `public` is for an internet-facing install and turns on secure-only cookies,
# pinned socket origins, HTTPS enforcement and a strict session-secret check.
# See deploy/cloud/env.example and docs/cloud-hosting.md for that path.
EXPOSURE=lan

# Number of reverse proxies in front of this server. Keep at 0 on the LAN, where
# there is none. Trusting a hop that does not exist lets any client forge its own
# address and evade the sign-in rate limiter below.
TRUST_PROXY=0

# Failed sign-in budget, per address and per account. Staff PINs are four digits,
# so this is the only thing bounding an automated guesser.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15

# Extra browser origins allowed to open an authenticated socket, comma separated.
# Only needed if the front end is served from somewhere other than this server.
ALLOWED_ORIGINS=
