# ---- The Lord Erroll — hosted configuration ----
# Copy to deploy/cloud/.env and fill in. This file holds the session secret, so
# it never belongs in git; the repository ignores .env everywhere.

# The hostname guests and staff will type, and the one Caddy gets a certificate
# for. It must already resolve to this machine's public address.
SITE_ADDRESS=order.lorderroll.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=it@lorderroll.com

# Tells the server it is internet-facing: secure-only cookies, pinned socket
# origins, HTTPS enforced, and a refusal to start on a weak session secret.
EXPOSURE=public

# Printed into every table QR code, so settle it before printing the cards.
# Must match SITE_ADDRESS and must be https.
PUBLIC_BASE_URL=https://order.lorderroll.com

# Generate with:  openssl rand -base64 48
# Anyone who learns this can mint a manager session. Rotating it signs everyone out.
SESSION_SECRET=

# One reverse proxy (Caddy) stands in front of the app, so one hop is trusted.
# Raising this without a matching proxy lets clients forge their own address and
# walk through the sign-in rate limiter.
TRUST_PROXY=1

# Paths inside the container. Both are Docker volumes; leave them alone.
DATABASE_PATH=/data/lord-erroll.db
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# Sign-in attempt budget. Staff PINs are four digits, so this is what stands
# between the pad and an automated guesser.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=10
LOGIN_LOCKOUT_MINUTES=15

# Trading settings, as on-premise.
SERVICE_CHARGE_PERCENT=10
VAT_PERCENT=16
PRICES_INCLUDE_VAT=true
CURRENCY=KES
USD_RATE=129
